{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssetManifest",
  "description": "Paquete estructurado de video con metadatos",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del video"
    },
    "file_path": {
      "type": "string",
      "description": "Ruta local al archivo de video"
    },
    "status": {
      "type": "string",
      "enum": ["raw", "processing", "processed"],
      "description": "Estado del procesamiento del video"
    },
    "metadata": {
      "type": "object",
      "description": "Metadatos del video",
      "properties": {
        "total_duration_sec": {
          "type": "number",
          "minimum": 0,
          "description": "Duración total en segundos"
        },
        "created_at": {
          "type": "string",
          "description": "Fecha de creación del video"
        }
      }
    }
  },
  "required": ["video_id", "file_path", "status"],
  "additionalProperties": false
}
